{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Agent-Compose currently requires a single daemon replica because its SQLite state is single-writer."
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "guestImage": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "properties": {
        "driver": {"type": "string", "enum": ["k8s"]},
        "sandboxNamespace": {"type": "string"},
        "runtimeBaseURL": {"type": "string"}
      },
      "required": ["driver"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessMode": {"type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"]},
        "size": {"type": "string", "minLength": 1}
      },
      "required": ["enabled", "accessMode", "size"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "required": ["type", "port"]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "automountServiceAccountToken": {"type": "boolean"}
      },
      "required": ["create", "automountServiceAccountToken"]
    },
    "rbac": {
      "type": "object",
      "properties": {"create": {"type": "boolean"}},
      "required": ["create"]
    }
  },
  "required": ["replicaCount", "image", "guestImage", "runtime", "persistence", "service", "serviceAccount", "rbac"]
}
